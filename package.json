{
  "name": "@aptos-labs/sign-in-with-aptos",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "check": "turbo check test",
    "clean": "turbo clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build --filter=@aptos-labs/siwa && changeset publish",
    "vite-example": "turbo dev --filter=@aptos-labs/siwa-vite --filter=@aptos-labs/siwa-backend --ui tui",
    "vite-legacy-example": "turbo dev --filter=@aptos-labs/siwa-vite-legacy --filter=@aptos-labs/siwa-backend --ui tui"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@changesets/cli": "^2.29.8",
    "@types/node": "22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "turbo": "^2.7.4",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "better-sqlite3",
      "bufferutil",
      "cytoscape",
      "esbuild",
      "sharp",
      "utf-8-validate"
    ],
    "overrides": {
      "@issacs/brace-expansion": "^5.0.1",
      "brace-expansion@^2": "^2.0.3",
      "minimatch@^9": "^9.0.7",
      "minimatch@^10": "^10.2.3",
      "picomatch@^2": "^2.3.2",
      "picomatch@^4": "^4.0.4",
      "rollup@^4": "^4.59.0",
      "axios": "^1.15.2",
      "dompurify": "^3.4.0",
      "uuid@^11": "^11.1.1",
      "postcss": "^8.5.10",
      "vite": "^7.3.2",
      "lodash-es": "^4.18.0",
      "yaml@^2": "^2.8.3",
      "bn.js@^5": "^5.2.3",
      "@xmldom/xmldom@^0.9.0": "^0.9.10"
    }
  }
}
